# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# (o .env está no .gitignore: nunca vai para o GitHub)

# Ambiente: development | production
# Em production, DATABASE_URL e ADMIN_SENHA passam a ser obrigatórios.
APP_ENV=development

# Porta HTTP
PORT=8080

# Nome exibido nas telas
NOME_EVENTO=Amigo Secreto

# Senha do painel do organizador (/organizador). Em produção: mínimo 8 caracteres.
# Vazia em desenvolvimento = uma senha temporária aparece no console.
ADMIN_SENHA=

# String de conexão do PostgreSQL. VAZIA = banco H2 em arquivo (./data), sem instalar nada.
# PostgreSQL local do docker-compose.yml (porta 5433):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/amigo_secreto?sslmode=disable
# Neon (cole a connection string do painel, ela já vem com sslmode=require):
#   DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
